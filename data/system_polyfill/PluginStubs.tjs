// PluginStubs.tjs — shims for KiriKiri Z plugins that games link unguarded
// (fpslimit.dll, addFont.dll, fstat.dll, krkrsteam.dll, extrans.dll ...).
// The engine supplies the useful behaviour itself; these keep scripts that
// expect the native surface working.

// krkrsteam.dll is absent off-Steam: expose a void Steam so games that check
// `Steam !== void` skip the Steam paths.
try { if(Steam === void) {} } catch(e) { global.Steam = void; }

if(typeof System != 'undefined') {
	System.fpslimit = 0;					// fpslimit.dll: 0 = uncapped
	System.addFont = function(fn) { try { Font.addFont(fn); } catch(e) {} };	// addFont.dll
	System.getFileTime = function(fn) { return -1; };							// fstat.dll
}

// fstat.dll
function FileTime(fn) { return -1; }

// extrans.dll montage/effect classes. Minimal no-op equivalents so scenarios
// that construct them do not raise.
class Quake      { function Quake() {}      function start() {} function stop() {} function finalize() {} }
class Rain       { function Rain() {}       function start() {} function stop() {} function finalize() {} }
class Zoom       { function Zoom() {}       function start() {} function stop() {} function finalize() {} }
class MotionBlur { function MotionBlur() {} function start() {} function stop() {} function finalize() {} }
class FallenLeaf { function FallenLeaf() {} function start() {} function stop() {} function finalize() {} }

// adjustmoni.dll — dialog position adjuster. YesNoDialog.tjs calls
// global.AdjustMoni(%[window,left2,top2,width2,height2]) and reads .x/.y to
// place the dialog. Without this the member is undefined and the script throws
// ("Member \"AdjustMoni\" does not exist"), e.g. when a Yes/No dialog appears
// during save/load. Reproduce the script's commented-out intent: centre the
// dialog over its parent window, clamped to the screen.
function AdjustMoni(params)
{
	var w = params.width2, h = params.height2;
	var x = (System.screenWidth  - w) >> 1;
	var y = (System.screenHeight - h) >> 1;
	try
	{
		var win = params.window;
		if(win !== void)
		{
			x = ((win.width  - w) >> 1) + win.left;
			y = ((win.height - h) >> 1) + win.top;
		}
	}
	catch(e) { /* keep the screen-centred fallback */ }
	if(x < 0) x = 0;
	if(y < 0) y = 0;
	if(x + w > System.screenWidth)  x = System.screenWidth  - w;
	if(y + h > System.screenHeight) y = System.screenHeight - h;
	return %[ "x" => int(x), "y" => int(y) ];
}
