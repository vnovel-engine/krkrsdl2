// LayerCompat.tjs — obsolete Layer methods removed in KiriKiriZ.
// (cf. krkrz/docs/TJS2/deleted.md) Re-expressed via current primitives.
Layer.affineBlend = function(src, sleft, stop, swidth, sheight, affine, A, B, C, D, E, F, opa, type) {
	this.operateAffine(src, sleft, stop, swidth, sheight, affine, A, B, C, D, E, F, omOpaque, opa, type);
};
Layer.affinePile = function(src, sleft, stop, swidth, sheight, affine, A, B, C, D, E, F, opa, type) {
	this.operateAffine(src, sleft, stop, swidth, sheight, affine, A, B, C, D, E, F, omAuto, opa, type);
};
Layer.blendRect = function(dleft, dtop, src, sleft, stop, swidth, sheight, opa) {
	this.operateRect(dleft, dtop, src, sleft, stop, swidth, sheight, omOpaque, opa);
};
Layer.pileRect = function(dleft, dtop, src, sleft, stop, swidth, sheight, opa) {
	this.operateRect(dleft, dtop, src, sleft, stop, swidth, sheight, omAuto, opa);
};
Layer.stretchBlend = function(dleft, dtop, dwidth, dheight, src, sleft, stop, swidth, sheight, opa, type) {
	this.operateStretch(dleft, dtop, dwidth, dheight, src, sleft, stop, swidth, sheight, omOpaque, opa, type);
};
Layer.stretchPile = function(dleft, dtop, dwidth, dheight, src, sleft, stop, swidth, sheight, opa, type) {
	this.operateStretch(dleft, dtop, dwidth, dheight, src, sleft, stop, swidth, sheight, omAlpha, opa, type);
};

/* The Stretch(arg) property-bag helper used to live here. It is not an obsolete
 * Layer method, so it moved to Util.tjs, which loads unconditionally - keeping
 * it here meant disabling this shim removed a function the game needs. */
